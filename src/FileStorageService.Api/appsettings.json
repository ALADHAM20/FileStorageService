{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=LAPTOP-PF53K6V5\\SQLEXPRESS;Integrated Security=True;Persist Security Info=False;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Command Timeout=30"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "MigrationRetryCount": 10,
    "MigrationRetryDelaySeconds": 5
  },
  "Storage": {
    "RootPath": "_storage"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://127.0.0.1:4200"
    ]
  },
  "Upload": {
    "MaxUploadBytes": 104857600,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png"
    ]
  },
  "Files": {
    "Query": {
      "DefaultPageSize": 20,
      "MaxPageSize": 100
    },
    "Preview": {
      "AllowedContentTypes": [
        "application/pdf"
      ],
      "AllowedContentTypePrefixes": [
        "image/"
      ]
    },
    "ResumableUpload": {
      "SessionLifetimeHours": 24
    }
  },
  "Jwt": {
    "Issuer": "FileStorageService",
    "Audience": "FileStorageService.Client",
    "SigningKey": "development-only-signing-key-change-before-production-12345",
    "MockTokenLifetimeMinutes": 480
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "FileStorageService.Api"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
